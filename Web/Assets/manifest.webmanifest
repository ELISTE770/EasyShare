{
  "name": "שיתוף קל PRO | EasyShare",
  "short_name": "שיתוף קל",
  "description": "מרכז שיתוף קבצים, סטרימינג וענן מקומי בין המחשב לסמארטפון",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "background_color": "#0b1120",
  "theme_color": "#0b1120",
  "orientation": "any",
  "lang": "he",
  "dir": "rtl",
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/api/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "לוח שיתוף מהיר",
      "short_name": "לוח שיתוף",
      "description": "סנכרון טקסטים וקישורים בין מחשב לנייד",
      "url": "/?tab=clipboard"
    },
    {
      "name": "העלאת קבצים",
      "short_name": "העלאה",
      "description": "העלאת קבצים מהירה למחשב",
      "url": "/?action=upload"
    }
  ]
}
