<Window x:Class="EasyShare.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שיתוף קל PRO | EasyShare - מרכז שיתוף קבצים, סטרימינג וענן"
        Icon="Assets/app.ico"
        Height="780" Width="1080"
        MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <!-- ===================================================================
             סגנון TabControl מודרני: Segmented Capsule Pill Bar
             עיצוב צף ונקי המשלב את עקרונות Linear ו-Windows 11 Fluent
             =================================================================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- סרגל קפסולות Segmented עליון -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4"
                                    Margin="0,0,0,14"
                                    SnapsToDevicePixels="True">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>

                            <!-- תוכן הכרטיסייה הנבחרת -->
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================================
             סגנון TabItem מודרני: קפסולה חלקה עם אינדיקטור אקסנט זוהר
             =================================================================== -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="3,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushCardHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushCard}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushBorderHighlight}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================================
             סגנון כפתורים מודרני: סקוורקל מעוגל, אפקט לחיצה, מצבי ריחוף והילה
             =================================================================== -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource BrushSurface}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSubtle}" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================================
             תבנית ComboBox מודרנית במצב כהה
             =================================================================== -->
        <ControlTemplate x:Key="ModernDarkComboBoxTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
                <ToggleButton x:Name="DropDownToggle"
                              Focusable="False"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <!-- חץ נפתח מעוצב -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource BrushTextMuted}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrushText}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,3,34,3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- תפריט הפריטים הנפתח -->
                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                                Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Margin="0,4,0,4"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template" Value="{StaticResource ModernDarkComboBoxTemplate}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter TextElement.Foreground="{StaticResource BrushText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushPrimary}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushPrimaryHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================================
             סגנון פריטי רשימה ListBoxItem במצב כהה
             =================================================================== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================================================================
             כותרת עליונה ומצב שרת (Obsidian Studio Header)
             =================================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- לוגו וכותרת מותג -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="{StaticResource BrushPrimaryGradient}"
                            Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#2563EB" />
                        </Border.Effect>
                        <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtAppTitle" Text="שיתוף קל" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushText}" />
                            <Border Background="{StaticResource BrushPrimary}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtAppSubtitle" Text="File Sharing, Cloud Drops &amp; Streaming Suite" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- בקרות ימניות: שפה, סטטוס וכפתור הפעלה/כיבוי -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- מתג שפה יוקרתי -->
                    <Button x:Name="BtnLanguageToggleTop"
                            Content="🌐 English"
                            Padding="12,7"
                            FontWeight="Bold"
                            FontSize="12"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Foreground="{StaticResource BrushAccentCyan}"
                            Cursor="Hand"
                            Margin="0,0,16,0"
                            Click="BtnLanguageToggleTop_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- קפסולת סטטוס שרת פועמת (Radar Beacon) -->
                    <Border Background="#0C1F18"
                            BorderBrush="#1B4D3E"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="10,5"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="10" Height="10"
                                     Fill="{StaticResource BrushSuccess}"
                                     Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtServerStatus"
                                       Text="השרת פועל ומאזין"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSuccess}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- כפתור עצירת שרת -->
                    <Button x:Name="BtnToggleServerTop"
                            Content="עצור שרת 🛑"
                            Padding="14,7"
                            FontWeight="Bold"
                            FontSize="12.5"
                            Background="{StaticResource BrushDanger}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnToggleServer_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================
             תוכן הטאבים הראשי
             =================================================================== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,10">

            <!-- טאב 1: שרת רשת מקומי ואינטרנט -->
            <TabItem x:Name="TabServer" Header="🌐 שרת רשת ומדיה">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- עמודה ימנית: כרטיסי חיבורים ואינטרנט -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <!-- כרטיס רשת מקומית Wi-Fi -->
                        <Border Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,14"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="LblLocalNetworkTitle" Text="🏠 כתובת ברשת המקומית (Wi-Fi / LAN)" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushText}" />
                                        <TextBlock x:Name="LblLocalNetworkSubtitle" Text="התחבר מכל טלפון או מחשב המחוברים לאותו הראוטר" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,10" />
                                        <!-- שדה URL עם בידוד LTR מוחלט -->
                                        <TextBox x:Name="TxtLocalUrl"
                                                 IsReadOnly="True"
                                                 FontSize="15"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource BrushAccentCyan}"
                                                 Background="{StaticResource BrushSurface}"
                                                 BorderBrush="{StaticResource BrushBorder}"
                                                 BorderThickness="1.5"
                                                 Padding="12,9"
                                                 Margin="0,0,0,12"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenLocalBrowser" Content="פתח בדפדפן 🌐" Padding="16,8" Background="{StaticResource BrushPrimary}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnOpenLocalBrowser_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="BtnCopyLocalUrl" Content="העתק כתובת 📋" Padding="16,8" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="BtnCopyLocalUrl_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- כרטיס מנהור אינטרנט עולמי Cloudflare HTTPS -->
                        <Border Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,14"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="LblTunnelTitle" Text="🌍 מנהור אינטרנט עולמי (Cloudflare Tunnels)" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushText}" />
                                        <TextBlock x:Name="LblTunnelSubtitle" Text="שיתוף קבצים מאובטח ב-HTTPS מכל מקום בעולם ללא פתיחת פורטים" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,10" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableTunnel" Grid.Column="1" Content="הפעל מנהור" Foreground="{StaticResource BrushText}" FontWeight="Bold" VerticalAlignment="Center" Checked="ChkEnableTunnel_Checked" Unchecked="ChkEnableTunnel_Unchecked" />
                                </Grid>

                                <!-- בחירת סוג מנהור -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                    <RadioButton x:Name="RbTunnelRandom" Content="מנהור אקראי (Quick Tunnel - ללא הגדרה)" GroupName="TunnelModeGroup" IsChecked="True" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" Margin="0,0,20,0" Checked="RbTunnelMode_Changed" Unchecked="RbTunnelMode_Changed" />
                                    <RadioButton x:Name="RbTunnelCustom" Content="דומיין אישי קבוע (Custom Domain עם Token)" GroupName="TunnelModeGroup" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" Checked="RbTunnelMode_Changed" Unchecked="RbTunnelMode_Changed" />
                                </StackPanel>

                                <!-- פאנל הגדרות דומיין אישי וטוקן -->
                                <Border x:Name="PnlCustomDomainConfig" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblCustomDomainUrl" Text="כתובת דומיין אישי:" Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtCustomDomainUrl" Grid.Column="1" Height="36" VerticalContentAlignment="Center" Background="{StaticResource BrushCard}" Foreground="{StaticResource BrushAccentCyan}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,0" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="למשל: https://share.smartbinary.org או share.mydomain.com">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></TextBox.Resources>
                                            </TextBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblTunnelToken" Text="טוקן (Tunnel Token):" Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtTunnelToken" Grid.Column="1" Height="36" VerticalContentAlignment="Center" Background="{StaticResource BrushCard}" Foreground="{StaticResource BrushAccentCyan}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,0" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="הדבק כאן את מפתח ה-Token של ה-Tunnel מ-Cloudflare Zero Trust">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></TextBox.Resources>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBox x:Name="TxtTunnelUrl"
                                         Text="המנהור כבוי (סמן 'הפעל מנהור' לפתיחת כתובת ציבורית)"
                                         IsReadOnly="True"
                                         FontSize="13.5"
                                         Foreground="{StaticResource BrushWarning}"
                                         Background="{StaticResource BrushSurface}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         BorderThickness="1.5"
                                         Padding="12,9"
                                         Margin="0,0,0,12"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                </TextBox>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenTunnelBrowser" Content="פתח כתובת ציבורית 🌐" Padding="16,8" Background="{StaticResource BrushSuccess}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" IsEnabled="False" Click="BtnOpenTunnelBrowser_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="BtnCopyTunnelUrl" Content="העתק קישור 📋" Padding="16,8" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" IsEnabled="False" Click="BtnCopyTunnelUrl_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- לוג חיבורים ואירועים -->
                        <Border Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <TextBlock x:Name="LblEventLogTitle" Text="📝 לוג פעילות חיבורים בזמן אמת" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
                                <TextBox x:Name="TxtEventLog"
                                         Height="130"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#06090F"
                                         Foreground="{StaticResource BrushAccentCyan}"
                                         FontFamily="Consolas, Cascadia Code, monospace"
                                         FontSize="11.5"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         Padding="10">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></TextBox.Resources>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- עמודה שמאלית: קוד QR וחיבור מהיר מסמארטפון -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblQrTitle" Text="📱 חיבור מהיר ממצלמת הטלפון" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock x:Name="LblQrSubtitle" Text="כוון את מצלמת הסמארטפון אל הקוד כדי להתחבר ברגע" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18" />

                            <Border Background="White"
                                    CornerRadius="14"
                                    Padding="14"
                                    HorizontalAlignment="Center"
                                    Width="220" Height="220">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                                </Border.Effect>
                                <Image x:Name="ImgQrCode" Width="192" Height="192" Stretch="Uniform" />
                            </Border>

                            <TextBlock x:Name="LblQrFooter" Text="שיתוף מלא | נגני מדיה | העלאה והורדה" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- טאב 2: שיתוף קבצים מאובטח, העלאה לענן, Google Drive ו-OneDrive -->
            <TabItem x:Name="TabSecureShare" Header="🔐 שיתוף מאובטח והעלאה לענן">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock x:Name="LblSecureShareTitle" Text="🔒 יצירת קישור שיתוף מאובטח לקובץ או תיקייה" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,0,0,4" />
                            <TextBlock x:Name="LblSecureShareSubtitle" Text="שתף קבצים ברשת, באינטרנט, בענן מוצפן, או ישירות דרך Google Drive ו-OneDrive" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,16" />

                            <!-- בחירת פריט לשיתוף -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSecureTarget"
                                         Height="42"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         FontSize="13.5"
                                         Background="{StaticResource BrushSurface}"
                                         Foreground="{StaticResource BrushText}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         BorderThickness="1.5"
                                         Padding="12,0"
                                         Text="בחר קובץ או תיקייה לשיתוף...">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                </TextBox>
                                <Button x:Name="BtnSelectFile" Content="בחר קובץ 📄" Height="42" Margin="10,0,0,0" Padding="18,0" Background="{StaticResource BrushPrimary}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSelectFile_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnSelectFolder" Content="בחר תיקייה 📁" Height="42" Margin="8,0,0,0" Padding="18,0" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnSelectFolder_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <!-- שורת שירותי ענן אישיים מזוהים במחשב -->
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblCloudDirectTitle" Text="☁️ שיתוף ישיר לשירותי הענן האישיים (Google Drive &amp; OneDrive)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrushText}" />
                                        <TextBlock x:Name="TxtCloudServicesStatus" Text="מזהה שירותי ענן מסונכרנים במחשב..." FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnShareGoogleDriveDirect" Grid.Column="1" Content="📁 שתף ב-Google Drive" Height="36" Padding="14,0" Background="#0D9488" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" ToolTip="מעתיק את הקובץ ללוח (Ctrl+V) ופותח את Google Drive" Click="BtnShareGoogleDriveDirect_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="BtnShareOneDriveDirect" Grid.Column="2" Content="⛅ שתף ב-OneDrive" Height="36" Padding="14,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" ToolTip="סנכרון מקומי אוטומטי ל-OneDrive" Click="BtnShareOneDriveDirect_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- אפשרויות וערוצי שיתוף מפורטים -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ערוץ שיתוף -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblChannel" Text="ערוץ הפצה:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <ComboBox x:Name="CmbShareChannel" SelectedIndex="0">
                                        <ComboBoxItem x:Name="CmbChanLan" Content="🏠 רשת מקומית (LAN Wi-Fi)" Tag="LAN" />
                                        <ComboBoxItem x:Name="CmbChanTunnel" Content="🔒 אינטרנט עולמי (Cloudflare HTTPS)" Tag="Tunnel" />
                                        <ComboBoxItem x:Name="CmbChanDirectCloud" Content="⚡ ענן ישיר אוטומטי (קישור מיידי)" Tag="DirectCloud" />
                                        <ComboBoxItem x:Name="CmbChanCloud" Content="☁️ ענן מוצפן ב-PIN (Cloud Relay)" Tag="Cloud" />
                                        <ComboBoxItem x:Name="CmbChanGoogleDrive" Content="📁 Google Drive (גוגל דרייב)" Tag="GoogleDrive" />
                                        <ComboBoxItem x:Name="CmbChanOneDrive" Content="⛅ Microsoft OneDrive (וואן-דרייב)" Tag="OneDrive" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- קוד PIN -->
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock x:Name="LblPinCode" Text="קוד PIN לאימות:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSecurePin"
                                                 Height="40"
                                                 FontSize="14.5"
                                                 FontWeight="Bold"
                                                 Text="12345678"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="{StaticResource BrushSurface}"
                                                 Foreground="{StaticResource BrushAccentCyan}"
                                                 BorderBrush="{StaticResource BrushBorder}"
                                                 BorderThickness="1.5"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                        </TextBox>
                                        <Button x:Name="BtnGenPin" Grid.Column="1" Content="🎲" Height="40" Width="40" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Foreground="White" Cursor="Hand" Margin="6,0,0,0" ToolTip="הגרל קוד PIN חדש" Click="BtnGenPin_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- זמן תפוגה -->
                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock x:Name="LblExpiration" Text="זמן תפוגה:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <ComboBox x:Name="CmbExpiration" SelectedIndex="0">
                                        <ComboBoxItem x:Name="CmbExpUnlimited" Content="ללא הגבלה (תמידי ♾️)" Tag="0" />
                                        <ComboBoxItem x:Name="CmbExp15Min" Content="15 דקות" Tag="15" />
                                        <ComboBoxItem x:Name="CmbExp1Hour" Content="שעה אחת" Tag="60" />
                                        <ComboBoxItem x:Name="CmbExp6Hours" Content="6 שעות" Tag="360" />
                                        <ComboBoxItem x:Name="CmbExp24Hours" Content="24 שעות" Tag="1440" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- כמות הורדות -->
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock x:Name="LblMaxDownloads" Text="הגבלת הורדות:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <ComboBox x:Name="CmbMaxDownloads" SelectedIndex="0">
                                        <ComboBoxItem x:Name="CmbMaxDl1" Content="הורדה 1 (השמדה עצמית 💥)" Tag="1" />
                                        <ComboBoxItem x:Name="CmbMaxDl3" Content="עד 3 הורדות" Tag="3" />
                                        <ComboBoxItem x:Name="CmbMaxDl10" Content="עד 10 הורדות" Tag="10" />
                                        <ComboBoxItem x:Name="CmbMaxDlUnlimited" Content="ללא הגבלה" Tag="0" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- כפתור יצירת שיתוף ראשי -->
                            <Button x:Name="BtnCreateSecureShare"
                                    Content="צור קישור שיתוף / העבר לענן 🔒"
                                    Height="46"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Background="{StaticResource BrushPrimaryGradient}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnCreateSecureShare_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                            </Button>

                            <!-- כרטיס תוצאה של הקישור שנוצר -->
                            <Border x:Name="BorderShareResult"
                                    Visibility="Collapsed"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushPrimary}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtResultHeader" Text="🎉 הקובץ מוכן לשיתוף בהצלחה!" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,8" />
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtResultUrl"
                                                 Height="38"
                                                 VerticalContentAlignment="Center"
                                                 IsReadOnly="True"
                                                 FontSize="13.5"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource BrushAccentCyan}"
                                                 Background="{StaticResource BrushCard}"
                                                 BorderBrush="{StaticResource BrushBorder}"
                                                 BorderThickness="1.5"
                                                 Padding="12,0"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                        </TextBox>
                                        <Button x:Name="BtnCopyShareUrl" Grid.Column="1" Content="העתק קישור 📋" Height="38" Margin="8,0,0,0" Padding="14,0" Background="{StaticResource BrushPrimary}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCopyShareUrl_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnResultOpenBrowser" Grid.Column="2" Content="פתח ב-Web 🌐" Height="38" Margin="6,0,0,0" Padding="14,0" Background="{StaticResource BrushSuccess}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnResultOpenBrowser_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnResultShowExplorer" Grid.Column="3" Content="הצג בסייר 📁" Height="38" Margin="6,0,0,0" Padding="14,0" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnResultShowExplorer_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="LblPinVerification" Text="קוד אימות PIN / אבטחה:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="TxtResultPinDisplay" Text="12345678" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                        <Button x:Name="BtnCopyShareFullMessage" Content="העתק הודעה מוכנה לוואטסאפ / מייל 💬" Height="34" Padding="16,0" Background="{StaticResource BrushSuccess}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCopyShareFullMessage_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- רשימת העברות פעילות -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock x:Name="LblActiveTransfersTitle" Text="📋 קישורי שיתוף פעילים כעת" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushText}" Margin="0,0,0,10" />
                            <ListBox x:Name="LstActiveTransfers" Height="170" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" Foreground="{StaticResource BrushText}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Channel}" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusDescription}" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="{Binding CancelButtonText}" Padding="10,4" Background="{StaticResource BrushDanger}" Foreground="White" BorderThickness="0" Cursor="Hand" Tag="{Binding Token}" Click="BtnCancelTransfer_Click">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- טאב 3: הגדרות מתקדמות -->
            <TabItem x:Name="TabSettings" Header="⚙️ הגדרות מתקדמות">
                <Border Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,14,0,0"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <TextBlock x:Name="LblSettingsHeader" Text="הגדרות שרת ואבטחה מתקדמות" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,0,0,18" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="LblSettingsPort" Text="יציאת שרת (Server Port):" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtSettingsPort" Height="40" Text="2121" Padding="12,0" VerticalContentAlignment="Center" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" FlowDirection="LeftToRight" TextAlignment="Left">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock x:Name="LblSettingsAccessMode" Text="מצב גישה למחשב:" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbSettingsAccessMode" SelectedIndex="0">
                                    <ComboBoxItem x:Name="CmbItemAccessFull" Content="גישה מלאה לכל הכוננים והמחשב (Full Computer)" Tag="FullComputer" />
                                    <ComboBoxItem x:Name="CmbItemAccessSingle" Content="הגבלה לתיקייה ייעודית בלבד (Single Folder)" Tag="SingleFolder" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock x:Name="LblSettingsLanguage" Text="שפת ממשק (Language):" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbSettingsLanguage" SelectedIndex="0" SelectionChanged="CmbSettingsLanguage_SelectionChanged">
                                    <ComboBoxItem Content="עברית (Hebrew)" Tag="he" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="LblSettingsSharedFolder" Text="תיקיית שיתוף ייעודית (במצב Single Folder):" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsSharedFolder" Height="40" VerticalContentAlignment="Center" IsReadOnly="True" Padding="12,0" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" FlowDirection="LeftToRight" TextAlignment="Left">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                </TextBox>
                                <Button x:Name="BtnSettingsBrowseFolder" Grid.Column="1" Content="עיון תיקייה 📁" Height="40" Padding="18,0" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="BtnSettingsBrowseFolder_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,8,0,18">
                            <CheckBox x:Name="ChkSettingsRecycleBin" Content="השתמש בסל המחזור של Windows (Recycle Bin) בעת מחיקת קבצים" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkSettingsReadOnly" Content="מצב קריאה בלבד (Read-Only Mode) - חוסם מחיקה והעלאה" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ChkSettingsHidden" Content="הצג קבצים ותיקיות מוסתרים" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ChkSettingsHotkey" Content="קיצור מקשים גלובלי (Alt+S) - שיתוף קובץ/תמונה מהלוח או צילום מסך חי" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkSettingsContextMenu" Content="תפריט קליק ימני בסייר הקבצים של Windows (שתף באמצעות EasyShare)" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ChkSettingsDropZone" Content="ווידג'ט צף שולחני (Floating Drop-Zone) לגרירה מהירה של קבצים" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ChkSettingsAutoStartTunnel" Content="הפעל מנהור Cloudflare אוטומטית בהפעלת השרת" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}" Margin="0,0,0,10" />
                        </StackPanel>

                        <Button x:Name="BtnSaveSettings" Content="שמור הגדרות 💾" Padding="22,12" FontSize="14.5" FontWeight="Bold" Background="{StaticResource BrushPrimary}" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnSaveSettings_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- טאב 4: ניטור ובקרה חי -->
            <TabItem x:Name="TabMonitor" Header="📊 ניטור ובקרה חי">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- כרטיס גרף מהירות רשת בזמן אמת (Telemetry Oscilloscope HUD) -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="LblBandwidthTitle" Text="📈 תעבורת רשת בזמן אמת (Upload Bandwidth):" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushAccentCyan}" />
                                <TextBlock x:Name="TxtCurrentSpeedDisplay" Text="0.00 Mbps" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushSuccess}" Margin="16,0,0,0" />
                                <TextBlock x:Name="LblBandwidthDetails" Text="• פורט 2121 • mDNS פעיל (easyshare.local)" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="18,2,0,0" />
                            </StackPanel>

                            <Canvas x:Name="BandwidthCanvas" Grid.Row="1" ClipToBounds="True" Background="#06090F">
                                <Polyline x:Name="SpeedLine" Stroke="{StaticResource BrushAccentCyan}" StrokeThickness="2.5" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- רשימת חיבורים פעילים (Linear Active Connections) -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock x:Name="LblLiveConnectionsTitle" Text="👥 הורדות וחיבורים אקטיביים בזמן אמת" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushText}" />
                                <TextBlock x:Name="TxtActiveConnCount" Text="(0 חיבורים)" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" Margin="10,2,0,0" />
                            </StackPanel>

                            <ListView x:Name="LstLiveConnections" Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" Foreground="{StaticResource BrushText}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn x:Name="ColSource" Header="מקור" Width="55">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CountryFlag}" FontSize="16" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="ColClientIp" Header="כתובת IP" DisplayMemberBinding="{Binding ClientIp}" Width="120" />
                                        <GridViewColumn x:Name="ColTargetFile" Header="קובץ במשיכה" DisplayMemberBinding="{Binding TargetFileName}" Width="200" />
                                        <GridViewColumn x:Name="ColProgress" Header="התקדמות" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="10" Width="120" Foreground="{StaticResource BrushAccentCyan}" Background="{StaticResource BrushSurface}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="ColActions" Header="פעולות" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="נתק חיבור 🚫" Background="{StaticResource BrushDanger}" Foreground="White" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand" Tag="{Binding ConnectionId}" Click="BtnTerminateConnection_Click">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===================================================================
             סרגל סטטוס תחתון (Obsidian Studio Footer)
             =================================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,10"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtFooterInfo"
                           Text="שיתוף קל PRO | פועל במצב משתמש (No Admin / UAC Required)"
                           FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="BtnBottomDropZone" Content="ווידג'ט צף 🎯" Background="Transparent" Foreground="{StaticResource BrushAccentCyan}" BorderThickness="0" Cursor="Hand" FontSize="12.5" Margin="0,0,16,0" Click="BtnToggleDropZone_Click" />
                    <Button x:Name="BtnBottomContextMenu" Content="תפריט ימני בסייר 📁" Background="Transparent" Foreground="{StaticResource BrushSuccess}" BorderThickness="0" Cursor="Hand" FontSize="12.5" Margin="0,0,16,0" Click="BtnToggleContextMenu_Click" />
                    <Button x:Name="BtnBottomMinimize" Content="מזער למגש המערכת 📥" Background="Transparent" Foreground="{StaticResource BrushTextMuted}" BorderThickness="0" Cursor="Hand" FontSize="12.5" Click="BtnMinimizeToTray_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
