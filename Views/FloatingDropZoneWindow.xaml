<Window x:Class="EasyShare.Views.FloatingDropZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyShare Drop-Zone"
        Height="88" Width="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="DropZone_DragEnter"
        DragLeave="DropZone_DragLeave"
        Drop="DropZone_Drop"
        MouseLeftButtonDown="DropZone_MouseLeftButtonDown">

    <Window.Resources>
        <Storyboard x:Key="PulseGlow">
            <DoubleAnimation Storyboard.TargetName="OuterGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.9" Duration="0:0:0.6"
                             AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.08" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.08" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleTransform" CenterX="44" CenterY="44" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <!-- הילה זוהרת מסביב (Obsidian Cyan/Indigo Glow) -->
        <Ellipse x:Name="OuterGlow"
                 Width="84" Height="84"
                 Fill="{DynamicResource BrushAccentCyan}"
                 Opacity="0.3">
            <Ellipse.Effect>
                <BlurEffect Radius="16" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- מעטפת הכפתור העגול -->
        <Border x:Name="MainCircle"
                Width="70" Height="70"
                CornerRadius="35"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushPrimary}"
                BorderThickness="2"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.7" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- תצוגה רגילה -->
                <StackPanel x:Name="PnlNormal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="↑" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtDropLabel" Text="גרור לכאן" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- חיווי התקדמות -->
                <ProgressBar x:Name="PrgBusy"
                             IsIndeterminate="True"
                             Width="46" Height="4"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource BrushAccentCyan}"
                             Background="{DynamicResource BrushSurface}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
