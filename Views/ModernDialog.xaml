<Window x:Class="EasyShare.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyShare"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="520"
        FlowDirection="RightToLeft"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- כפתור ראשי מעוצב -->
        <Style x:Key="ModernDialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGradient}" />
            <Setter Property="Foreground" Value="#0B0F14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="24,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- כפתור משני מעוצב -->
        <Style x:Key="ModernDialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurface}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- מעטפת חיצונית עם צל ומסגרת יוקרתית -->
    <Border Margin="16"
            Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushBorderHighlight}"
            BorderThickness="1.5"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- סרגל כותרת עם גרירה וסגירה -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurface}"
                    CornerRadius="14,14,0,0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtTitle"
                               Text="הודעה"
                               FontWeight="Bold"
                               FontSize="14.5"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="26" Height="26"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushTextMuted}"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="12"
                            Cursor="Hand"
                            Click="BtnClose_Click" />
                </Grid>
            </Border>

            <!-- תוכן ההודעה והאייקון -->
            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- אייקון סמנטי מעוצב -->
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1.5"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TxtIcon"
                               Text="✓"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushSuccess}" />
                </Border>

                <!-- טקסט ההודעה -->
                <TextBlock x:Name="TxtMessage"
                           Grid.Column="1"
                           Text="תוכן ההודעה"
                           FontSize="13.5"
                           Foreground="{DynamicResource BrushText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="22"
                           TextAlignment="Right" />
            </Grid>

            <!-- אזור כפתורי פעולה -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSurface}"
                    CornerRadius="0,0,14,14"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0">
                <StackPanel x:Name="PnlButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <!-- כפתור אישור / כן -->
                    <Button x:Name="BtnPrimary"
                            Content="אישור"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnPrimary_Click" />

                    <!-- כפתור ביטול / לא -->
                    <Button x:Name="BtnSecondary"
                            Content="ביטול"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="BtnSecondary_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
